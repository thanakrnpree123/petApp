# Copy to `.env` (which git ignores) and fill in, then run:
#   flutter run --dart-define-from-file=.env
#
# These values are compiled into the app, so they are NOT secret. Only put
# client-safe values here. Never add a RevenueCat secret key (sk_...).

# RevenueCat → Project settings → API keys → the app's public SDK key.
REVENUECAT_APPLE_API_KEY=
REVENUECAT_GOOGLE_API_KEY=

# Debug builds only: show a sample "$2.99 (mock)" offering while the stores
# and the RevenueCat dashboard aren't set up. Ignored in release builds.
REVENUECAT_MOCK=true

# Firebase App Check (see docs/app-check-setup.md).
# Debug builds only: a debug token registered in the Firebase console. It is
# a secret: keep it out of release builds and CI release secrets.
APP_CHECK_DEBUG_TOKEN=
# Public reCAPTCHA Enterprise site key for the web app.
APP_CHECK_WEB_SITE_KEY=
