rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Pet photos are uploaded to users/{userId}/pets/{petId}/photo.jpg
    // (see lib/services/storage_service.dart).
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
