rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The user's own profile document. `isPremium` grants PawHealth Plus
    // on the web (where App Store/Play Store IAP doesn't exist) and must
    // only ever be set by a trusted writer — the Firebase Console or an
    // Admin SDK script, both of which bypass these rules — never by the
    // client. A signed-in user may read and update their own doc, but any
    // write that touches `isPremium` is rejected, so no client can grant
    // itself Plus.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && !('isPremium' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isPremium']);
      // In-app account deletion (App Store guideline 5.1.1(v)). Deleting
      // the doc can't grant Plus, so no isPremium check is needed.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Pet subcollections (health_logs, vaccinations, symptom_checks, etc.)
    // are unrestricted for their owner — `isPremium` never lives here.
    match /users/{userId}/{collection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Articles are global content: readable by any signed-in user,
    // writable only via the Admin SDK (which bypasses rules).
    match /articles/{articleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
